# 有域名：自动签发 HTTPS（Let's Encrypt）。DEMO_DOMAIN 在 .env 里配，如 demo.example.com
# 无域名裸 IP 演示：把第一行改成 :80 （无 HTTPS，仅限临时）
{$DEMO_DOMAIN}

encode gzip

# 安全响应头：令牌存 localStorage 且会话 12 小时，须防点击劫持与 MIME 嗅探
header {
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
    -Server
}

# API 反代到后端（actuator 不对公网暴露）
@api path /api/*
handle @api {
    reverse_proxy app:8090 {
        # 审计留痕需要真实操作终端 IP（等保要求可溯源）；Caddy 默认会追加 X-Forwarded-For，
        # 这里显式写明，避免将来调整反代配置时丢失
        header_up X-Real-IP {remote_host}
    }
}

# 带内容哈希的构建产物：长缓存。缺失时必须回 404 而不是 index.html——
# 否则升级后老页面去取已被删除的旧 chunk，拿到一份 HTML 当 JS 解析，直接白屏，
# 且因为 HTTP 200 连重试都不会发生。
handle /assets/* {
    root * /srv/dist
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
}

# SPA 入口与前端路由回退：index.html 绝不能被缓存，否则用户始终拿旧版资源清单
handle {
    root * /srv/dist
    header Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
}
