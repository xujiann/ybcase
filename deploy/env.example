# 复制为 .env 后填写真实值（.env 不要提交仓库）
# 数据库口令：随机强口令
DB_PASSWORD=请改成随机强口令
# JWT 密钥：≥48位随机串（python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=请改成随机48位以上
# 访问域名（Caddy 据此自动签 HTTPS）。三选一：
#   1) 有自己的域名：填如  yb.example.com，并把该域名 A 记录指向服务器 IP
#   2) 没域名但要 HTTPS：用 sslip.io 通配 DNS，填 <服务器IP>.sslip.io，如 43.129.201.125.sslip.io
#   3) 纯 IP 无 HTTPS（仅极短临时，令牌走明文有风险）：留空并把 Caddyfile 首行改成 :80
DEMO_DOMAIN=43.129.201.125.sslip.io
# 管理员初始口令：仅在**空库**首次启动时用于创建 admin，首次登录会强制修改。
# 仓库是公开的，pilot 下缺失或仍为 admin123 会拒绝启动；生产库不再创建 banban/fazhi/juzhang 演示账号。
ADMIN_INIT_PASSWORD=请改成随机强口令
# SIMULATION为默认，保留模拟记录的性质；FORMAL拒绝模拟新签并要求正式回证证据。
YBCASE_RUNTIME_MODE=SIMULATION
# 健康告警（healthcheck.sh，可选）：群机器人 webhook 地址与类型（wecom|dingtalk|feishu）。不配则只写 healthcheck.log
#ALERT_WEBHOOK=
#ALERT_WEBHOOK_TYPE=wecom
#ALERT_DISK_PERCENT=85
#ALERT_BACKUP_MAX_AGE_HOURS=30

# 外部网关按需启用，具体协议见上线清单。令牌仅在受控环境配置。
#YBCASE_INTEGRATION_MONITOR_ENABLED=false
#YBCASE_INTEGRATION_MONITOR_URL=
#YBCASE_INTEGRATION_MONITOR_TOKEN=
#YBCASE_INTEGRATION_TREASURY_ENABLED=false
#YBCASE_INTEGRATION_TREASURY_URL=
#YBCASE_INTEGRATION_TREASURY_TOKEN=
#YBCASE_INTEGRATION_SIGNATURE_ENABLED=false
#YBCASE_INTEGRATION_SIGNATURE_URL=
#YBCASE_INTEGRATION_SIGNATURE_TOKEN=
# 电子送达：真实供应商联调通过后启用。专用回执账号只授INTEGRATION角色。
#YBCASE_INTEGRATION_DELIVERY_ENABLED=false
#YBCASE_INTEGRATION_DELIVERY_URL=
#YBCASE_INTEGRATION_DELIVERY_TOKEN=
#YBCASE_INTEGRATION_DELIVERY_CALLBACK_USERNAME=
#YBCASE_INTEGRATION_DELIVERY_RECEIPT_TIMEOUT_HOURS=168
#YBCASE_INTEGRATION_DELIVERY_TIMEOUT_SCAN_ENABLED=false
